{
  "expo": {
    "name": "snap-done",
    "slug": "snap-done",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.snapdone.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.snapdone.app"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "SnapDone reads the screenshot you pick to extract its details on your device.",
          "cameraPermission": "SnapDone uses the camera to scan bills and tickets on your device.",
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "SnapDone adds events you confirm to your calendar.",
          "remindersPermission": "SnapDone adds reminders you confirm to your reminders list."
        }
      ],
      "expo-notifications",
      "llama.rn"
    ],
    "scheme": "snapdone",
    "experiments": {
      "typedRoutes": true
    }
  }
}
